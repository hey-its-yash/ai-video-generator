# ================================
# APP CONFIGURATION
# ================================
APP_NAME=AI Rhyme Video Generator
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ================================
# API KEYS (REQUIRED)
# ================================

# Google Gemini API (PRIMARY - FREE)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY= ENTER_YOUR_API_KEY
# HuggingFace Token (REQUIRED - FREE)
# Get your token from: https://huggingface.co/settings/tokens


# ================================
# API KEYS (OPTIONAL)
# ================================

# OpenAI API (Fallback - Paid)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Replicate API (Alternative - Paid but Free Credits)
# Get your token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_token_here

# Stability AI API (Alternative - Paid)
# Get your key from: https://platform.stability.ai/
STABILITY_API_KEY=sk-your_stability_key_here

# ================================
# LLM SETTINGS
# ================================
DEFAULT_LLM=gemini                  # Options: gemini, openai, huggingface
LLM_TEMPERATURE=0.7                 # Creativity (0.0-1.0)
MAX_TOKENS=1500                     # Max response length
LLM_TIMEOUT=60                      # Timeout in seconds

# ================================
# VIDEO GENERATION SETTINGS
# ================================
DEFAULT_VIDEO_MODE=animated         # Options: fast, animated, experimental, premium
VIDEO_FPS=24                        # Frames per second
VIDEO_RESOLUTION=512                # Options: 512, 768, 1024
MAX_SCENES=8                        # Maximum scenes per video
SCENE_DURATION=5                    # Seconds per scene
VIDEO_FORMAT=mp4                    # Output format

# ================================
# IMAGE GENERATION SETTINGS
# ================================
IMAGE_MODEL=stabilityai/stable-diffusion-2-1
IMAGE_GUIDANCE_SCALE=7.5            # How closely to follow prompt (1-20)
IMAGE_NUM_INFERENCE_STEPS=30        # Quality vs Speed (20-50)
IMAGE_SEED=-1                       # -1 for random, fixed number for consistency

# ================================
# VIDEO GENERATION SETTINGS
# ================================
# Primary model: LTX-Video (faster, better quality)
VIDEO_MODEL=Lightricks/LTX-Video
# Fallback: Stable Video Diffusion
VIDEO_MODEL_FALLBACK=stabilityai/stable-video-diffusion-img2vid-xt
VIDEO_FRAMES=14                     # Number of frames (14-25)
VIDEO_MOTION_BUCKET_ID=127          # Motion intensity (1-255)
VIDEO_FPS_ID=7                      # Target FPS (5-30)
VIDEO_DURATION=5                    # Duration in seconds

# ================================
# AUDIO SETTINGS
# ================================
TTS_LANGUAGE=en                     # Language code
TTS_ACCENT=com                      # com=US, co.uk=UK, co.in=India, etc.
TTS_SLOW=False                      # Slow speech for clarity
ENABLE_BACKGROUND_MUSIC=True        # Add background music
BACKGROUND_MUSIC_VOLUME=0.2         # Volume (0.0-1.0)

# ================================
# FILE PATHS
# ================================
OUTPUT_DIR=outputs
SCENES_DIR=outputs/scenes
AUDIO_DIR=outputs/audio
VIDEOS_DIR=outputs/videos
TEMP_DIR=outputs/temp
ASSETS_DIR=assets
MUSIC_DIR=assets/music
EXAMPLES_DIR=assets/examples

# ================================
# PERFORMANCE SETTINGS
# ================================
MAX_CONCURRENT_REQUESTS=3           # Parallel API requests
REQUEST_TIMEOUT=120                 # API timeout in seconds
ENABLE_CACHING=True                 # Cache LLM & API responses
CACHE_TTL=86400                     # Cache time-to-live (24 hours)
MAX_RETRIES=3                       # API retry attempts
RETRY_DELAY=2                       # Seconds between retries

# ================================
# STYLE PRESETS
# ================================
DEFAULT_STYLE=children_book         # Options: children_book, cartoon, watercolor, 3d
STYLE_CONSISTENCY_SEED=True         # Use same seed for all scenes

# ================================
# SAFETY & LIMITS
# ================================
MAX_RHYME_LENGTH=500                # Max characters in input
MIN_SCENES=3                        # Minimum scenes required
MAX_VIDEO_DURATION=120              # Max video length in seconds
MAX_FILE_SIZE_MB=100                # Max output file size

# ================================
# DEVELOPMENT
# ================================
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR
ENABLE_CORS=True                    # Enable CORS for development
ALLOWED_ORIGINS=*                   # CORS allowed origins
